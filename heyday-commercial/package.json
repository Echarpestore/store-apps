{
  "name": "heyday-commercial",
  "version": "1.0.0",
  "private": true,
  "description": "HEYDAY - premium motion graphics commercial (Remotion + SVG)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "preview:build": "node tools/build-preview.mjs",
    "preview": "node tools/build-preview.mjs && python3 -m http.server 4173 -d preview",
    "music": "python3 tools/make_music.py /tmp/heyday-raw.wav && ffmpeg -y -loglevel error -i /tmp/heyday-raw.wav -af loudnorm=I=-15:TP=-1.2:LRA=11 -ar 48000 public/audio/heyday-score.wav",
    "render:vertical": "remotion render src/index.ts HeydayVertical out/heyday-vertical-1080x1920.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=256k --timeout=90000",
    "render:horizontal": "remotion render src/index.ts HeydayHorizontal out/heyday-horizontal-1920x1080.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=256k --timeout=90000",
    "render:all": "npm run render:vertical && npm run render:horizontal",
    "stills": "node tools/stills.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fontsource/fraunces": "5.1.0",
    "@fontsource/inter": "5.1.0",
    "@remotion/cli": "4.0.300",
    "@remotion/player": "4.0.300",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.300",
    "typescript": "5.6.3"
  }
}
